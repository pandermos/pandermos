# Pandermos secrets. Keep this file mode 640, owner root:pandermos.

# Claude credentials, pick ONE:
#  - Claude Pro/Max subscription: run `claude setup-token` on any machine and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
#  - or an Anthropic API key (billed per token):
#ANTHROPIC_API_KEY=

# Telegram notifications (optional). Create a bot with @BotFather, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic webhook (optional). Receives {"text": "...", "content": "..."}:
# works with Slack incoming webhooks, Discord webhooks, ntfy, n8n, Zapier...
WEBHOOK_URL=
